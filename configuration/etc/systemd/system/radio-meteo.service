[Unit]
Description=Meteor LRPT pass monitor
After=network-online.target time-sync.target radio-center.service
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=radio-center
Group=radio-center
WorkingDirectory=/opt/radio-center
ExecStart=/usr/bin/python3 /opt/radio-center/meteo_scheduler.py
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectSystem=strict
ReadWritePaths=/var/lib/radio-center
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
Restart=no
TimeoutStopSec=65

[Install]
WantedBy=multi-user.target
